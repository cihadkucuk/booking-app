generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum DepositType {
  NONE
  FIXED
  PERCENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  MANUAL
  ONLINE
  INBOX
}

enum ConversationChannel {
  SMS
  WHATSAPP
  INSTAGRAM
  EMAIL
  STUB
}

enum ConversationStatus {
  OPEN
  ARCHIVED
  SPAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

enum ShoppingListStatus {
  SUGGESTED
  APPROVED
  PURCHASED
  SKIPPED
}

model Studio {
  id                     String                     @id @default(cuid())
  slug                   String                     @unique
  name                   String
  customDomain           String?                    @unique
  logoUrl                String?
  primaryColor           String                     @default("#111827")
  secondaryColor         String                     @default("#F59E0B")
  theme                  Json?
  stripeConnectId        String?
  emailSenderDomain      String?
  staffCanViewClientPhone Boolean                   @default(true)
  staffCanViewClientEmail Boolean                   @default(true)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  users                  User[]
  staff                  Staff[]
  clients                Client[]
  services               Service[]
  appointments           Appointment[]
  conversations          Conversation[]
  messages               Message[]
  shoppingTemplateItems  ShoppingTemplateItem[]
  shoppingListItems      ShoppingListItem[]
  availabilityRules      StaffAvailabilityRule[]
  availabilityExceptions StaffAvailabilityException[]
}

model User {
  id                  String        @id @default(cuid())
  studioId            String
  studio              Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  email               String
  passwordHash        String
  fullName            String
  role                UserRole
  isActive            Boolean       @default(true)
  staff               Staff?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  appointmentsCreated Appointment[] @relation("AppointmentCreatedBy")

  @@unique([studioId, email])
  @@index([studioId, role])
}

model Staff {
  id                   String                     @id @default(cuid())
  studioId             String
  studio               Studio                     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  userId               String?                    @unique
  user                 User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName          String
  color                String?                    @default("#2563EB")
  bio                  String?
  isActive             Boolean                    @default(true)
  appointments         Appointment[]
  services             StaffService[]
  availabilityRules    StaffAvailabilityRule[]
  availabilityExceptions StaffAvailabilityException[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([studioId, isActive])
}

model Client {
  id            String         @id @default(cuid())
  studioId      String
  studio        Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  fullName      String
  phone         String?
  email         String?
  source        String?
  notes         String?
  conversations Conversation[]
  messages      Message[]
  appointments  Appointment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([studioId, fullName])
  @@index([studioId, phone])
}

model Service {
  id              String        @id @default(cuid())
  studioId        String
  studio          Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  name            String
  category        String?
  durationMin     Int
  priceCents      Int
  bufferBeforeMin Int           @default(0)
  bufferAfterMin  Int           @default(0)
  depositType     DepositType   @default(NONE)
  depositValue    Int           @default(0)
  isActive        Boolean       @default(true)
  appointments    Appointment[]
  staff           StaffService[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([studioId, isActive])
}

model StaffService {
  staffId    String
  serviceId  String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([staffId, serviceId])
}

model Appointment {
  id                String            @id @default(cuid())
  studioId          String
  studio            Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staffId           String
  staff             Staff             @relation(fields: [staffId], references: [id], onDelete: Restrict)
  clientId          String
  client            Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId         String
  service           Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdByUserId   String?
  createdBy         User?             @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  startAt           DateTime
  endAt             DateTime
  status            AppointmentStatus @default(PENDING)
  source            AppointmentSource @default(MANUAL)
  depositAmountCents Int              @default(0)
  notes             String?
  cancelReason      String?
  cancelledAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([studioId, startAt])
  @@index([studioId, staffId, startAt])
  @@index([studioId, clientId, startAt])
}

model StaffAvailabilityRule {
  id          String   @id @default(cuid())
  studioId    String
  studio      Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studioId, staffId, dayOfWeek])
}

model StaffAvailabilityException {
  id            String   @id @default(cuid())
  studioId      String
  studio        Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  staffId       String
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date          DateTime
  startMinute   Int?
  endMinute     Int?
  isUnavailable Boolean  @default(true)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studioId, staffId, date])
}

model Conversation {
  id              String             @id @default(cuid())
  studioId        String
  studio          Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  channel         ConversationChannel
  externalThreadId String?
  status          ConversationStatus @default(OPEN)
  lastMessageAt   DateTime?
  messages        Message[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([studioId, channel, externalThreadId])
  @@index([studioId, status, lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  studioId          String
  studio            Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  direction         MessageDirection
  externalMessageId String?
  text              String
  attachments       Json?
  status            MessageStatus    @default(QUEUED)
  createdAt         DateTime         @default(now())

  @@index([studioId, conversationId, createdAt])
}

model ShoppingTemplateItem {
  id                 String             @id @default(cuid())
  studioId           String
  studio             Studio             @relation(fields: [studioId], references: [id], onDelete: Cascade)
  name               String
  unit               String?
  category           String?
  avgUsagePerService Decimal?           @db.Decimal(10, 2)
  isActive           Boolean            @default(true)
  listItems          ShoppingListItem[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([studioId, isActive])
}

model ShoppingListItem {
  id                String            @id @default(cuid())
  studioId          String
  studio            Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  weekStartDate     DateTime
  templateItemId    String?
  templateItem      ShoppingTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  name              String
  unit              String?
  quantitySuggested Decimal           @db.Decimal(10, 2)
  quantityManual    Decimal?          @db.Decimal(10, 2)
  reason            String?
  status            ShoppingListStatus @default(SUGGESTED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([studioId, weekStartDate, status])
}

