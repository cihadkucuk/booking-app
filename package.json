{
  "name": "booking-app-platform",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @booking/db generate",
    "db:migrate": "pnpm --filter @booking/db migrate",
    "db:seed": "pnpm --filter @booking/db seed"
  },
  "devDependencies": {
    "pnpm": "^10.30.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
